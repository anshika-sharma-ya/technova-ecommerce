{
  "info": {
    "_postman_id": "technova-ecommerce-api-collection",
    "name": "TechNova E-Commerce REST API",
    "description": "Postman Collection for TechNova Full-Stack E-Commerce Platform (React + Express + PostgreSQL/SQLite)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Auth - Customer Login (Aadya)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"user@ecommerce.com\",\n  \"password\": \"user123\"\n}"
        },
        "url": {
          "raw": "http://localhost:5000/api/auth/login",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "5000",
          "path": [
            "api",
            "auth",
            "login"
          ]
        },
        "description": "Authenticates customer user Aadya and returns JWT token."
      },
      "response": []
    },
    {
      "name": "2. RBAC Security - Unauthorized Delete Product (Returns 403 Forbidden)",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{CUSTOMER_TOKEN}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "http://localhost:5000/api/products/1",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "5000",
          "path": [
            "api",
            "products",
            "1"
          ]
        },
        "description": "Attempts to delete a product using a customer JWT token (Aadya). Security RBAC middleware blocks this action with a 403 Forbidden status."
      },
      "response": []
    },
    {
      "name": "3. Auth - Admin Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@ecommerce.com\",\n  \"password\": \"admin123\"\n}"
        },
        "url": {
          "raw": "http://localhost:5000/api/auth/login",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "5000",
          "path": [
            "api",
            "auth",
            "login"
          ]
        },
        "description": "Authenticates System Admin and returns JWT token."
      },
      "response": []
    },
    {
      "name": "4. Products - Get All Tech Catalog",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:5000/api/products",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "5000",
          "path": [
            "api",
            "products"
          ]
        }
      },
      "response": []
    },
    {
      "name": "5. AI - Nova AI Chat Assistant",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"message\": \"Best laptop for coding under ₹1,00,000\"\n}"
        },
        "url": {
          "raw": "http://localhost:5000/api/ai/chat",
